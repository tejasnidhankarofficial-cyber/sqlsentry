# Postgres superuser (container init + data loading only; the app never uses it)
POSTGRES_DB=olist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_PORT=5432

# Application roles (created by db/init/03_roles.sh)
READONLY_PASSWORD=change-me-readonly
AUDIT_PASSWORD=change-me-audit

# LLM (OpenAI). Set the model you have access to.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Web app access
APP_PASSWORD=choose-a-shared-password
AUTH_SECRET=generate-with-python-secrets-token_urlsafe-32
ALLOWED_USERS=              # optional, comma-separated usernames; empty = any valid username
DAILY_LIMIT_PER_USER=50
DAILY_LIMIT_GLOBAL=500
API_URL=http://127.0.0.1:8000
